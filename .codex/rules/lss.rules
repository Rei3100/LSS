# Raw API and push are conservative denials: prefixes cannot inspect later flags.
prefix_rule(pattern = ["gh","pr","create"], decision = "forbidden")
prefix_rule(pattern = ["gh","pr","comment"], decision = "forbidden")
prefix_rule(pattern = ["gh","pr","edit"], decision = "forbidden")
prefix_rule(pattern = ["gh","pr","review"], decision = "forbidden")
prefix_rule(pattern = ["gh","pr","close"], decision = "forbidden")
prefix_rule(pattern = ["gh","issue","create"], decision = "forbidden")
prefix_rule(pattern = ["gh","issue","comment"], decision = "forbidden")
prefix_rule(pattern = ["gh","issue","edit"], decision = "forbidden")
prefix_rule(pattern = ["gh","issue","close"], decision = "forbidden")
prefix_rule(pattern = ["gh","api"], decision = "forbidden")
prefix_rule(pattern = ["gh","label"], decision = "forbidden")
prefix_rule(pattern = ["gh","release"], decision = "forbidden")
prefix_rule(pattern = ["gh","gist"], decision = "forbidden")
prefix_rule(pattern = ["gh","repo","edit"], decision = "forbidden")
prefix_rule(pattern = ["gh","repo","delete"], decision = "forbidden")
prefix_rule(pattern = ["gh","repo","rename"], decision = "forbidden")
prefix_rule(pattern = ["gh","repo","archive"], decision = "forbidden")
prefix_rule(pattern = ["gh","secret"], decision = "forbidden")
prefix_rule(pattern = ["gh","variable"], decision = "forbidden")
prefix_rule(pattern = ["gh","ruleset"], decision = "forbidden")
prefix_rule(pattern = ["git","push"], decision = "forbidden")
