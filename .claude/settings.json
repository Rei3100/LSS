      "PowerShell(git push *--force*)",
      "PowerShell(git push *-f *)",
      "PowerShell(git push *--no-verify*)",
      "PowerShell(git commit *--no-verify*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|MultiEdit|Write|Bash|PowerShell|exec_command|shell_command|shell|functions.exec_command|functions.shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 -I \"${CLAUDE_PROJECT_DIR}/scripts/hooks/cookie_privacy_guard.py\" || { echo 'Access denied: privacy guard unavailable.' >&2; exit 2; }",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
